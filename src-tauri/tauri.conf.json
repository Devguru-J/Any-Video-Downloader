{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Any Video Downloader",
  "version": "0.1.0",
  "identifier": "dev.devguru.anyvideo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Any Video Downloader",
        "width": 980,
        "height": 640,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "Download video from any web page",
    "longDescription": "Detect and download video from any web page, including pages with JW Player, HLS, DASH, or generic HTML5 video."
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Devguru-J/Any-Video-Downloader/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_MINISIGN_PUBKEY_AT_RELEASE_TIME"
    }
  }
}
